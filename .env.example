PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cadence?retryWrites=true&w=majority

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Google account email of the admin (npm run seed marks it as admin)
ADMIN_NAME=Cadence Admin
ADMIN_EMAIL=your-admin@gmail.com

# Comma-separated list of allowed origins (React Native apps don't need CORS; this is for an admin web panel)
CORS_ORIGINS=*

# Google Sign-In: OAuth client IDs from Google Cloud Console (Web, Android, iOS), comma-separated
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com

# Firebase Phone Auth (OTP) - Project ID from Firebase console -> Project settings
FIREBASE_PROJECT_ID=cadence-music-academy
# Optional service account (not needed just to verify OTP tokens)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
