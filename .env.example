PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cadence?retryWrites=true&w=majority

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# First admin account, created by `npm run seed`
ADMIN_NAME=Cadence Admin
ADMIN_EMAIL=admin@cadence.local
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeMe@123

# Comma-separated list of allowed origins (React Native apps don't need CORS; this is for an admin web panel)
CORS_ORIGINS=*
